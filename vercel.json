{
  "buildCommand": "cd frontend && npm install @rolldown/binding-linux-x64-gnu --no-save --force && tsc -b && npx vite build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nexushr-backend.onrender.com/api/:path*"
    },
    {
      "source": "/((?!assets/|favicon.ico|vite.svg|.*\\.png|.*\\.json).*)$",
      "destination": "/index.html"
    }
  ]
}

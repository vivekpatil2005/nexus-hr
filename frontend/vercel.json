{
  "buildCommand": "npm install @rolldown/binding-linux-x64-gnu --no-save --loglevel=error --no-fund --no-audit && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nexushr-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
